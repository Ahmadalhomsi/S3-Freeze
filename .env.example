# Copy to .env (docker compose reads it automatically). Never commit .env.

# Encrypts stored S3 credentials and job passphrases. Generate with:
#   openssl rand -hex 32
# Keep a copy: without it, saved credentials cannot be decrypted.
MASTER_KEY=

# Creates the admin account on first start (stored hashed; change it later in
# Settings). Leave empty to create it in the browser with the one-time setup
# token printed in the logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to true once to reset the admin password to ADMIN_PASSWORD, then remove.
ADMIN_RESET=false

# Time zone for schedules.
TZ=UTC
